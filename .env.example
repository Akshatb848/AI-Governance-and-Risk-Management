# AEGIS needs no API keys. Both settings are optional; copy to .env or export them.
# Note: AEGIS reads these from the process environment (it does not load .env itself),
# e.g. `set -a; source .env; set +a` before `streamlit run app.py`.

# Where data/ and outputs/ live (default: the repository root)
# AEGIS_HOME=/path/to/aegis-home

# Default Hugging Face model for the RAG assistant (default: Qwen/Qwen2.5-1.5B-Instruct).
# On CPU, Qwen/Qwen2.5-0.5B-Instruct is the practical choice.
# AEGIS_LLM_ID=Qwen/Qwen2.5-0.5B-Instruct
